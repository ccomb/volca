dist-newstyle
dist/
.hie
*.o
*\.bin
**/*.zst
uv.lock

deps/
*.tar.gz
cbits/*.o

# Documentation and notes (except README)
*.txt
/scripts/*
!/scripts/build_chem_synonyms.py
!/scripts/propose_flow_bridges.py
!/scripts/check-data-version.sh
!/scripts/check-licenses-table.sh
node_modules/

# Generated source
src/Version.hs
src/Builtin/Literals.hs

# Local configuration
cabal.project.local
volca.local.toml

run*.sh
worktree-build.sh

# Data directories
DBs/
uploads/
cache/

# temporary python stuff (not pyvolca/)
/pyproject.toml
**/__pycache__/
**/*.egg-info/
pyvolca/build/
pyvolca/dist/

# local agent settings (shared .claude/settings.json IS tracked)
.claude/settings.local.json

# editor / OS cruft
.DS_Store
.vscode/
.idea/
.direnv/
.ghc.environment.*

# local secrets / credentials - restores the safety the old blanket `.*` rule
# gave, without re-ignoring the dot-config we now track on purpose.
.env*
.netrc

# agent scratch - todo/lesson notes written under .claude/ during a session
.claude/tasks/

# debug stuff
debug/

# Coverage reports
coverage-report/
*.tix

# Profiling output
*.prof
dist-prof/

.docker-bundle/
